# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Configurable Gemini model ID (defaults to gemini-3.7-flash)
GEMINI_MODEL="gemini-3.7-flash"

# RIME_API_KEY: Optional Rime TTS API Key for high-fidelity neural voice synthesis
RIME_API_KEY=""

# RIME_SPEAKER_ID: Rime speaker ID (e.g. "marsh", "amber", "abbie", "allison")
RIME_SPEAKER_ID="marsh"

# LIVEKIT_API_KEY: Optional LiveKit API Key for realtime low-latency audio transport
LIVEKIT_API_KEY=""

# LIVEKIT_API_SECRET: LiveKit API Secret
LIVEKIT_API_SECRET=""

# LIVEKIT_URL: LiveKit WebSocket server URL
LIVEKIT_URL=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

